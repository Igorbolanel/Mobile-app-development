<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ListApp.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/taskCardColor</item>
        <item name="cardCornerRadius">@dimen/corner_radius</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.ListApp.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">?attr/separatorLineColor</item>
        <item name="dividerInsetStart">@dimen/divider_inset</item>
        <item name="lastItemDecorated">false</item>
    </style>

    <style name="Widget.ListApp.AddButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/yellow</item>
        <item name="tint">@color/black</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ListApp.Circle</item>
    </style>

    <style name="ShapeAppearance.ListApp.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.ListApp.IconButton" parent="">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">?attr/colorPrimary</item>
    </style>

    <style name="Widget.ListApp.LargeTitle" parent="">
        <item name="android:textSize">@dimen/text_large_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="Widget.ListApp.RowText" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="Widget.ListApp.RowValue" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/gray</item>
    </style>

    <style name="Widget.ListApp.SearchField" parent="">
        <item name="android:background">@drawable/bg_search_field</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="drawableTint">@color/gray</item>
    </style>

    <style name="Widget.ListApp.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ListApp.TitleInput" parent="">
        <item name="android:background">@null</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">@dimen/text_note_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ListApp.NoteInput" parent="">
        <item name="android:background">@null</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">top</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Widget.ListApp.DeleteButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/red</item>
        <item name="backgroundTint">?attr/taskCardColor</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
    </style>

    <style name="Widget.ListApp.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonCompat">@drawable/checkbox_round</item>
        <item name="buttonTint">@null</item>
    </style>

    <style name="Animation.ListApp.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
